.progress {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--ink-600);
  padding: 20rpx 24rpx;
}

.progress-num {
  color: var(--green-700);
  font-weight: 600;
}

.progress-score {
  color: var(--ink-400);
}

.question-text {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.7;
  margin-bottom: 28rpx;
  color: var(--ink-900);
}

.option {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  margin-bottom: 18rpx;
  background: var(--green-050);
}

.option-press {
  transform: scale(0.98);
  background: #E7F3EF;
}

.option.selected {
  border-color: var(--green-700);
  background: var(--green-100);
}

.option.right {
  border-color: var(--green-600);
  background: var(--green-100);
}

.option.wrong {
  border-color: var(--red-500);
  background: var(--red-100);
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #DDE6E1;
  color: var(--ink-600);
  font-size: 26rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option.selected .option-label {
  background: var(--green-700);
  color: #fff;
}

.option.right .option-label {
  background: var(--green-600);
  color: #fff;
}

.option.wrong .option-label {
  background: var(--red-500);
  color: #fff;
}

.option-text {
  font-size: 28rpx;
  line-height: 1.5;
}

.explain-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.explain-title.ok { color: var(--green-700); }
.explain-title.no { color: var(--red-500); }

.explain-body {
  font-size: 26rpx;
  color: var(--ink-600);
  line-height: 1.7;
  background: var(--green-050);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.main-btn { margin-top: 8rpx; }

.btn-ghost {
  background: var(--green-100);
  color: var(--green-700);
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 18rpx 0;
  text-align: center;
  margin-top: 24rpx;
}

.result-card {
  text-align: center;
  padding: 60rpx 32rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.result-score {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--green-700);
}

.result-rate {
  font-size: 28rpx;
  color: var(--ink-600);
  margin: 16rpx 0 24rpx;
}

.result-tip {
  font-size: 24rpx;
  color: var(--ink-400);
}

/* ===== 题目来源标签 ===== */
.q-meta { margin-bottom: 16rpx; }

.q-source {
  display: inline-block;
  font-size: 20rpx;
  color: var(--green-700);
  background: var(--green-050);
  border: 2rpx solid var(--green-100);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* ===== 解析区：依据条款跳转 ===== */
.explain-rule {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--green-700);
  background: var(--green-050);
  border-radius: 14rpx;
  line-height: 1.5;
}
