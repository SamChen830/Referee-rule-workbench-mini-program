/* ===== 顶部品牌区：与系统导航栏（#0A4A3A）无缝衔接的一体绿头 ===== */
.hero {
  margin: -24rpx -24rpx 28rpx;
  background: linear-gradient(180deg, #0A4A3A 0%, #0F6E56 100%);
  padding: 28rpx 0 40rpx;
  color: #fff;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(10, 74, 58, 0.18);
}

.hero-inner { padding: 20rpx 32rpx 24rpx; }

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 模式胶囊切换 */
.mode-switch {
  display: flex;
  margin: 8rpx 32rpx 0;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  padding: 6rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.8);
  transition: all 0.2s;
}

.mode-item.active {
  background: #fff;
  color: var(--green-700);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 滑动切换提示 */
.swipe-hint {
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}

/* ===== 吸顶工具条（搜索 + 筛选），吸在系统导航栏正下方 ===== */
.sticky-bar {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--bg);
  margin: 0 -24rpx 20rpx;
  padding: 16rpx 24rpx 8rpx;
  box-shadow: 0 6rpx 12rpx rgba(23, 35, 31, 0.04);
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid var(--line);
}

.search-icon { font-size: 26rpx; margin-right: 12rpx; }

.search-input { flex: 1; font-size: 26rpx; }

.search-clear {
  color: var(--ink-400);
  font-size: 28rpx;
  padding: 0 8rpx;
}

/* ===== 筛选 chips ===== */
.chip-row {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink-600);
  font-size: 24rpx;
  border: 2rpx solid var(--line);
}

.chip-on {
  background: var(--green-700);
  color: #fff;
  border-color: var(--green-700);
  font-weight: 600;
}

.chip.tag { font-size: 22rpx; padding: 8rpx 20rpx; }

.tag-on {
  background: var(--green-100);
  color: var(--green-700);
  border-color: var(--green-600);
  font-weight: 600;
}

.result-meta {
  font-size: 22rpx;
  color: var(--ink-400);
  margin: 4rpx 8rpx 16rpx;
}

/* ===== 规则列表 ===== */
.rule-card {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 110, 86, 0.06);
}

.rule-no {
  flex-shrink: 0;
  width: 96rpx;
  text-align: center;
  background: var(--green-100);
  color: var(--green-700);
  font-weight: 700;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 10rpx 0;
  margin-right: 20rpx;
}

.rule-main { flex: 1; min-width: 0; }

.rule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rule-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.pill.obri {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
}

.rule-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-400);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-tags {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mini-tag {
  font-size: 20rpx;
  color: var(--green-700);
  background: var(--green-050);
  border: 2rpx solid var(--green-100);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.rule-chapter { font-size: 20rpx; color: var(--ink-400); margin-left: auto; }

.rule-arrow {
  align-self: center;
  color: var(--ink-400);
  font-size: 36rpx;
  margin-left: 8rpx;
}

/* ===== 裁判法 ===== */
.sec-head { display: flex; align-items: center; }

.sec-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: var(--green-700);
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.sec-info { flex: 1; }

.sec-name { font-size: 30rpx; font-weight: 600; }

.sec-ver { font-size: 22rpx; color: var(--ink-400); margin-top: 6rpx; }

.sec-arrow {
  color: var(--ink-400);
  font-size: 28rpx;
  transition: transform 0.2s;
}

.sec-arrow.open { transform: rotate(180deg); }

.mech-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.mech-no {
  font-size: 24rpx;
  color: var(--green-700);
  font-weight: 700;
  width: 72rpx;
}

.mech-title { flex: 1; font-size: 28rpx; }

.mech-chars { font-size: 20rpx; color: var(--ink-400); margin-right: 8rpx; }

.term-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.term-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.term-name { font-size: 28rpx; font-weight: 600; }

.term-text { font-size: 24rpx; color: var(--ink-600); line-height: 1.7; }

/* ===== 答题练习 ===== */
.stat-grid { display: flex; }

.stat { flex: 1; text-align: center; }

.stat-num { font-size: 44rpx; font-weight: 700; color: var(--ink-900); }

.stat-num.green { color: var(--green-700); }
.stat-num.red { color: var(--red-500); }

.stat-label { font-size: 22rpx; color: var(--ink-400); margin-top: 6rpx; }

.quiz-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }

.quiz-cat {
  width: calc(50% - 8rpx);
  background: var(--green-050);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.quiz-cat-name { font-size: 28rpx; font-weight: 600; color: var(--green-900); }

.quiz-cat-count { font-size: 22rpx; color: var(--green-700); margin-top: 8rpx; }

.quiz-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quiz-actions button { flex: 1; margin: 0; }

.btn-danger {
  background: var(--red-100);
  color: var(--red-500);
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.data-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-400);
  line-height: 1.6;
}

.wrong-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.wrong-item:last-child { border-bottom: none; }

.wrong-q { font-size: 26rpx; font-weight: 600; line-height: 1.6; }

.wrong-a { margin-top: 10rpx; font-size: 24rpx; color: var(--green-700); }

.wrong-e { margin-top: 8rpx; font-size: 22rpx; color: var(--ink-600); line-height: 1.6; }

/* ===== 空态 ===== */
.empty {
  text-align: center;
  color: var(--ink-400);
  font-size: 24rpx;
  padding: 60rpx 0;
}

/* ===== 搜索优化：热搜行 / 命中徽章 ===== */
.hot-row { padding-top: 12rpx; }

.hot-label {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--green-700);
  background: var(--green-050);
  border: 2rpx solid var(--green-100);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-right: 8rpx;
}

.mini-tag.obri-hit {
  color: #B45309;
  background: #FEF3C7;
  border-color: #FDE68A;
}

/* ===== 裁判法全局搜索：分组 + 命中摘要 ===== */
.group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 8rpx 12rpx;
}

.group-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.group-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-400);
}

.mech-hit {
  display: block;
  padding: 16rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}

.mech-hit:last-child { border-bottom: none; }

.mech-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mech-snippet {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-600);
  line-height: 1.6;
  overflow: hidden;
}

/* ===== 模式切换过渡动画：内容随滑动方向滑入 ===== */
.panel-next {
  animation: panelInNext 0.26s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.panel-prev {
  animation: panelInPrev 0.26s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes panelInNext {
  from { opacity: 0; transform: translateX(56rpx); }
  to { opacity: 1; transform: none; }
}

@keyframes panelInPrev {
  from { opacity: 0; transform: translateX(-56rpx); }
  to { opacity: 1; transform: none; }
}
